# TP4 on 4x DGX Spark, TP-MoE (EP1) instead of EP4: the measured
# previous production-champion serving profile (fixed k=3), superseded as
# the recommended mixed-traffic default by dynamic speculative length
# (profiles/tp4-tpmoe-dynk.env). Still a simpler, single-k alternative.
#
# Requires vllm-exl3 PR #36 (Hadamard-aligned uneven TP MoE,
# VLLM_EXL3_MOE_TP_ALIGN=128), PR #37 (padded-MoE loops bounded by
# n_valid), and PR #39 (padded-MoE expert-grouped stage1/5, decoding each
# trellis tile once per expert instead of once per slot):
# https://github.com/vcruz305/vllm-exl3/pull/36
# https://github.com/vcruz305/vllm-exl3/pull/37
# https://github.com/vcruz305/vllm-exl3/pull/39
#
# See profiles/tp4-tpmoe-dynk.env (dynamic k, recommended default),
# profiles/tp4-tpmoe.env (k=2, peak multi-user throughput) and
# profiles/tp4-tpmoe-k4.env (k=4, single-stream code/agent) for the other
# grouped-kernel profiles, and the general run sequence
# (ALLOW_EXPERIMENTAL_TP4_MOE_TP=1 on every cluster/serve step).
# configs/serve-tp4-tpmoe-k3.yaml is the serve config captured from the
# measured deployment.

IMAGE=deepseek-v41-exl3:tp4

MODEL=/models/DSV4.1-Flash-EXL3-4.75bpw
VLLM_ENGRAM_DISK_BACKED=1
VLLM_ENGRAM_MODEL_DIR=/models/DSV4.1-Flash-EXL3-4.75bpw

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=10
MAX_NUM_BATCHED_TOKENS=4096
TEXT_ONLY=1
DSPARK=1
EAGER=0
NATIVE_MOE=0
MOE_PARALLEL_MODE=tp

KV_CACHE_MEMORY_BYTES=8589934592
GPU_MEMORY_UTILIZATION=0.55

BLOCK_SIZE=128
PREFIX_CACHING=1

# DSpark: k=3 was the measured production-champion balance between the k=2
# all-round default and the k=4 code-heavy variant, with the grouped padded
# MoE kernel narrowing the gap that used to favor lower k under mixed
# concurrency. Captures multiples of 4 up to 40 to match the k=3 batch
# shapes (rows = max-num-seqs * (k+1) = 40).
NUM_SPECULATIVE_TOKENS=3
SPECULATIVE_QUANTIZATION=mxfp4

EXL3_MOE_KERNEL=native

COMPILATION_CONFIG='{"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[4,8,12,16,20,24,28,32,36,40]}'

VLLM_EXL3_ALLOW_SHAPE_MISMATCH=1
VLLM_EXL3_TRELLIS_ARENA=0
VLLM_EXL3_MADV_AFTER_H2D=0
VLLM_EXL3_PREFETCH=populate
VLLM_EXL3_PAD_SO_CB=2

VLLM_EXL3_MOE_TP_ALIGN=128

# Sized for the largest batch at k=3 (rows = max-num-seqs * (k+1) = 40).
# With PR #37, PADDED_MAX_T/NATIVE_MOE_MAX_ROWS headroom above the real row
# count is free; without it, set them to the exact row count.
VLLM_EXL3_PADDED_MAX_T=40
VLLM_EXL3_NATIVE_MOE_MAX_ROWS=40

# P2B_GROUPED=1 is the default once PR #39 is built in; set 0 to fall back
# to the pre-grouped per-slot padded MoE stages for A/B or rollback.
P2B_GROUPED=1

EXTRA_VLLM_ARGS='--engram-config {"cpu_offload":false}'

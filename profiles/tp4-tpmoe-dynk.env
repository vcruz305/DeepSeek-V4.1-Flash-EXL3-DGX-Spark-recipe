# TP4 on 4x DGX Spark, TP-MoE (EP1) instead of EP4: the measured
# production-champion serving profile (dynamic speculative length) — the
# recommended default for mixed traffic, replacing the fixed k=3 default.
#
# Requires vllm-exl3 PR #36 (Hadamard-aligned uneven TP MoE,
# VLLM_EXL3_MOE_TP_ALIGN=128), PR #37 (padded-MoE loops bounded by
# n_valid), and PR #39 (padded-MoE expert-grouped stage1/5, decoding each
# trellis tile once per expert instead of once per slot):
# https://github.com/vcruz305/vllm-exl3/pull/36
# https://github.com/vcruz305/vllm-exl3/pull/37
# https://github.com/vcruz305/vllm-exl3/pull/39
#
# See profiles/tp4-tpmoe.env (k=2, peak multi-user throughput),
# profiles/tp4-tpmoe-k3.env (fixed k=3, previous default) and
# profiles/tp4-tpmoe-k4.env (fixed k=4, single-stream code/agent) for the
# fixed-k alternatives, and the general run sequence
# (ALLOW_EXPERIMENTAL_TP4_MOE_TP=1 on every cluster/serve step).
# configs/serve-tp4-tpmoe-dynk.yaml is the serve config captured from the
# measured deployment.

IMAGE=deepseek-v41-exl3:tp4

MODEL=/models/DSV4.1-Flash-EXL3-4.75bpw
VLLM_ENGRAM_DISK_BACKED=1
VLLM_ENGRAM_MODEL_DIR=/models/DSV4.1-Flash-EXL3-4.75bpw

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=10
MAX_NUM_BATCHED_TOKENS=4096
TEXT_ONLY=1
EAGER=0
NATIVE_MOE=0
MOE_PARALLEL_MODE=tp

KV_CACHE_MEMORY_BYTES=8589934592
GPU_MEMORY_UTILIZATION=0.55

BLOCK_SIZE=128
PREFIX_CACHING=1

# Dynamic speculative length: DSpark picks num_speculative_tokens per step
# from num_speculative_tokens_per_batch_size instead of a single fixed k.
# k=4 for 1-4 concurrent sequences (higher acceptance pays off when the
# extra verified row is cheap); k=3 for 5-10 (acceptance gain no longer
# covers the extra row's step-time cost at that batch size). serve.sh's
# built-in DSPARK=1 flag only emits a fixed num_speculative_tokens, so this
# profile disables it and supplies the full speculative-config (with the
# per-batch-size schedule) through EXTRA_VLLM_ARGS below.
DSPARK=0
NUM_SPECULATIVE_TOKENS=4
SPECULATIVE_QUANTIZATION=mxfp4

EXL3_MOE_KERNEL=native

# Capture sizes must cover every row count either k in the schedule can
# produce: k=4 gives rows = seqs * 5 for seqs 1-4 (5/10/15/20); k=3 gives
# rows = seqs * 4 for seqs 5-10 (20/24/28/32/36/40).
COMPILATION_CONFIG='{"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[5,10,15,20,24,28,32,36,40]}'

VLLM_EXL3_ALLOW_SHAPE_MISMATCH=1
VLLM_EXL3_TRELLIS_ARENA=0
VLLM_EXL3_MADV_AFTER_H2D=0
VLLM_EXL3_PREFETCH=populate
VLLM_EXL3_PAD_SO_CB=2

VLLM_EXL3_MOE_TP_ALIGN=128

# Sized for the largest batch the schedule can produce (rows = max-num-seqs
# * (k_max+1) = 10 * 5 = 50, from the k=4 tier at low concurrency combined
# with max-num-seqs; 64 keeps the same headroom used by the fixed-k4
# profile). With PR #37, PADDED_MAX_T/NATIVE_MOE_MAX_ROWS headroom above
# the real row count is free; without it, set them to the exact row count.
VLLM_EXL3_PADDED_MAX_T=64
VLLM_EXL3_NATIVE_MOE_MAX_ROWS=64

# P2B_GROUPED=1 is the default once PR #39 is built in; set 0 to fall back
# to the pre-grouped per-slot padded MoE stages for A/B or rollback.
P2B_GROUPED=1

# DSPARK=0 above suppresses serve.sh's built-in fixed --speculative-config;
# this supplies the real one (with the dynamic per-batch-size schedule)
# plus the engram config, both normally emitted separately.
EXTRA_VLLM_ARGS='--speculative-config {"method":"dspark","num_speculative_tokens":4,"num_speculative_tokens_per_batch_size":[[1,4,4],[5,10,3]],"draft_sample_method":"probabilistic","rejection_sample_method":"block","quantization":"mxfp4"} --engram-config {"cpu_offload":false}'

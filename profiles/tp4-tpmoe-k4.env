# TP4 on 4x DGX Spark, TP-MoE (EP1) instead of EP4: the measured code-heavy /
# low-concurrency serving profile (k=4, DSpark's trained max at
# dspark_block_size=5).
#
# Requires vllm-exl3 PR #36 (Hadamard-aligned uneven TP MoE,
# VLLM_EXL3_MOE_TP_ALIGN=128) and PR #37 (padded-MoE loops bounded by
# n_valid): https://github.com/vcruz305/vllm-exl3/pull/36 and /pull/37
#
# See profiles/tp4-tpmoe.env for the all-round k=2 default and the general
# run sequence (ALLOW_EXPERIMENTAL_TP4_MOE_TP=1 on every cluster/serve step).
# configs/serve-tp4-tpmoe-k4.yaml is the serve config captured from the
# measured deployment.

IMAGE=deepseek-v41-exl3:tp4

MODEL=/models/DSV4.1-Flash-EXL3-4.75bpw
VLLM_ENGRAM_DISK_BACKED=1
VLLM_ENGRAM_MODEL_DIR=/models/DSV4.1-Flash-EXL3-4.75bpw

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=10
MAX_NUM_BATCHED_TOKENS=4096
TEXT_ONLY=1
DSPARK=1
EAGER=0
NATIVE_MOE=0
MOE_PARALLEL_MODE=tp

KV_CACHE_MEMORY_BYTES=8589934592
GPU_MEMORY_UTILIZATION=0.55

BLOCK_SIZE=128
PREFIX_CACHING=1

# DSpark: k=4 trades all-round throughput for peak code decode speed
# (+13% on the coding-peak cell vs. k=2; -9% on the c1 bench cell). Captures
# multiples of 5 up to 50 to match the k=4 batch shapes (rows = max-num-seqs
# * (k+1) = 50).
NUM_SPECULATIVE_TOKENS=4
SPECULATIVE_QUANTIZATION=mxfp4

EXL3_MOE_KERNEL=native

COMPILATION_CONFIG='{"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[5,10,15,20,25,30,35,40,45,50]}'

VLLM_EXL3_ALLOW_SHAPE_MISMATCH=1
VLLM_EXL3_TRELLIS_ARENA=0
VLLM_EXL3_MADV_AFTER_H2D=0
VLLM_EXL3_PREFETCH=populate
VLLM_EXL3_PAD_SO_CB=2

VLLM_EXL3_MOE_TP_ALIGN=128

# Sized for the largest batch at k=4 (rows = max-num-seqs * (k+1) = 50).
# With PR #37, PADDED_MAX_T/NATIVE_MOE_MAX_ROWS headroom above the real row
# count is free; without it, set them to the exact row count (64 was used
# during measurement).
VLLM_EXL3_PADDED_MAX_T=64
VLLM_EXL3_NATIVE_MOE_MAX_ROWS=64

EXTRA_VLLM_ARGS='--engram-config {"cpu_offload":false}'

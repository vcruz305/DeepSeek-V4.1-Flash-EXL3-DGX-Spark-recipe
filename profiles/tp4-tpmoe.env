# TP4 on 4x DGX Spark, TP-MoE (EP1) instead of EP4: the measured
# "all-round" / mixed-and-high-concurrency serving profile (k=2).
#
# Requires vllm-exl3 PR #36 (Hadamard-aligned uneven TP MoE,
# VLLM_EXL3_MOE_TP_ALIGN=128) and PR #37 (padded-MoE loops bounded by
# n_valid): https://github.com/vcruz305/vllm-exl3/pull/36 and /pull/37
#
#   set -a; . profiles/tp4-tpmoe.env; set +a
#   ALLOW_EXPERIMENTAL_TP4_MOE_TP=1 bash scripts/start_disk_engram_cluster.sh head      # head Spark
#   ALLOW_EXPERIMENTAL_TP4_MOE_TP=1 bash scripts/start_disk_engram_cluster.sh worker    # the other three
#   ALLOW_EXPERIMENTAL_TP4_MOE_TP=1 bash scripts/serve_tp4.sh                           # head only
#
# configs/serve-tp4-tpmoe-k2.yaml is the serve config captured from the
# measured deployment. It needs the image from scripts/build_tp4_runtime.sh
# built against the PR #36/#37 vllm-exl3 branch. Cold load is ~9 minutes.

IMAGE=deepseek-v41-exl3:tp4

# Snapshot path inside every container (host MODEL_DIR is mounted at /models).
MODEL=/models/DSV4.1-Flash-EXL3-4.75bpw
VLLM_ENGRAM_DISK_BACKED=1
VLLM_ENGRAM_MODEL_DIR=/models/DSV4.1-Flash-EXL3-4.75bpw

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=10
MAX_NUM_BATCHED_TOKENS=4096
TEXT_ONLY=1
DSPARK=1
EAGER=0
NATIVE_MOE=0

# TP-MoE: route MoE through tensor parallelism instead of expert parallelism.
# ALLOW_EXPERIMENTAL_TP4_MOE_TP=1 must also be exported before start_cluster
# and serve_tp4.sh (serve.sh refuses MOE_PARALLEL_MODE=tp on TP4 otherwise).
MOE_PARALLEL_MODE=tp

# Manual KV budget; same reservation as the EP4 profile.
KV_CACHE_MEMORY_BYTES=8589934592
GPU_MEMORY_UTILIZATION=0.55

BLOCK_SIZE=128
PREFIX_CACHING=1

# DSpark: k=2 is the measured all-round default with TP-MoE (serve.sh
# default is 5). See profiles/tp4-tpmoe-k4.env for the code-heavy k=4
# variant (DSpark's trained max at dspark_block_size=5).
NUM_SPECULATIVE_TOKENS=2
SPECULATIVE_QUANTIZATION=mxfp4

EXL3_MOE_KERNEL=native

# Decode-only CUDA graphs sized for max-num-seqs=10 at k=2 (rows =
# max_num_seqs * (k+1) = 30).
COMPILATION_CONFIG='{"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[3,6,9,12,15,18,21,24,27,30]}'

# EXL3 execution tuning from the measured workers.
VLLM_EXL3_ALLOW_SHAPE_MISMATCH=1
VLLM_EXL3_TRELLIS_ARENA=0
VLLM_EXL3_MADV_AFTER_H2D=0
VLLM_EXL3_PREFETCH=populate
VLLM_EXL3_PAD_SO_CB=2

# TP-MoE alignment (PR #36): pads uneven per-rank expert widths to a
# Hadamard-friendly boundary.
VLLM_EXL3_MOE_TP_ALIGN=128

# PADDED_MAX_T/NATIVE_MOE_MAX_ROWS are sized for the largest batch
# (rows = max-num-seqs * (k+1) = 30). With PR #37 this can be set generously
# (headroom is free); without PR #37 it must match the real row count.
VLLM_EXL3_PADDED_MAX_T=32
VLLM_EXL3_NATIVE_MOE_MAX_ROWS=32

EXTRA_VLLM_ARGS='--engram-config {"cpu_offload":false}'
